generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
}

enum PublicationStatus {
  DRAFT
  REVIEW
  PUBLISHED
  UNPUBLISHED
}

enum AuditType {
  TECHNICAL
  RESEARCH
  RISK
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         UserRole  @default(EDITOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  accounts     Account[]
  sessions     Session[]
  articles     Article[] @relation("ArticleEditor")
  audits       Audit[]   @relation("AuditEditor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Author {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  bio         String?   @db.Text
  role        String?
  avatarId    String?
  socialLinks Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  avatar      Media?    @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  articles    Article[]
  audits      Audit[]
}

model Category {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?   @db.Text
  seoTitle       String?
  seoDescription String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  articles       Article[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  articles Article[] @relation("ArticleTags")
}

model Media {
  id        String    @id @default(cuid())
  key       String    @unique
  url       String
  filename  String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  altText   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  authors   Author[]
  articles  Article[] @relation("ArticleFeaturedMedia")
  audits    Audit[]   @relation("AuditFeaturedMedia")
}

model ResearchSource {
  id          String      @id @default(cuid())
  name        String
  url         String      @unique
  sourceType  String
  accessedAt  DateTime?
  note        String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  articleRefs ArticleSource[]
  auditRefs   AuditSource[]
  firmRefs    PropFirmSource[]
}

model Article {
  id             String            @id @default(cuid())
  title          String
  slug           String            @unique
  excerpt        String?           @db.Text
  contentMarkdown String            @db.Text
  contentHtml    String?           @db.Text
  status         PublicationStatus @default(DRAFT)
  publishedAt    DateTime?
  lastReviewedAt DateTime?
  authorId       String?
  categoryId     String?
  featuredMediaId String?
  seoTitle       String?
  seoDescription String?           @db.Text
  canonical      String?
  ogImage        String?
  readingMinutes Int?
  legacyUrl      String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  editorId       String?
  author         Author?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredMedia  Media?            @relation("ArticleFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  editor         User?             @relation("ArticleEditor", fields: [editorId], references: [id], onDelete: SetNull)
  tags           Tag[]             @relation("ArticleTags")
  sources        ArticleSource[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
}

model Audit {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  entity          String
  auditType       AuditType
  riskLevel       String?
  status          PublicationStatus @default(DRAFT)
  summary         String?           @db.Text
  evidence        String?           @db.Text
  contentMarkdown String             @db.Text
  contentHtml     String?           @db.Text
  publishedAt     DateTime?
  lastReviewedAt  DateTime?
  authorId        String?
  featuredMediaId String?
  seoTitle        String?
  seoDescription  String?           @db.Text
  canonical       String?
  ogImage         String?
  legacyUrl       String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  editorId        String?
  author          Author?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  featuredMedia   Media?            @relation("AuditFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  editor          User?             @relation("AuditEditor", fields: [editorId], references: [id], onDelete: SetNull)
  sources         AuditSource[]

  @@index([status, publishedAt])
}

model PropFirm {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  country           String?
  challengeFee      String?
  profitTarget      String?
  profitSplit       String?
  dailyDrawdown     String?
  maximumDrawdown   String?
  payout            String?
  newsTrading       String?
  weekendHolding    String?
  expertAdvisor     String?
  consistency       String?
  scaling           String?
  platform          String?
  evaluationType    String?
  assessment        String?   @db.Text
  lastReviewedAt    DateTime?
  status            String?   @default("EVIDENCE_PENDING")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sources           PropFirmSource[]
}

model ArticleSource {
  articleId String
  sourceId  String
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source    ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([articleId, sourceId])
}

model AuditSource {
  auditId  String
  sourceId String
  audit    Audit          @relation(fields: [auditId], references: [id], onDelete: Cascade)
  source   ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([auditId, sourceId])
}

model PropFirmSource {
  propFirmId String
  sourceId   String
  propFirm   PropFirm       @relation(fields: [propFirmId], references: [id], onDelete: Cascade)
  source     ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([propFirmId, sourceId])
}
