{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/require-direct-url.mjs && prisma migrate deploy",
    "db:seed": "node scripts/require-direct-url.mjs && prisma db seed",
